# --- 클라이언트 (Expo, EXPO_PUBLIC_ 접두사만 앱 번들에 포함됨) ---
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-project.vercel.app
EXPO_PUBLIC_GEMINI_API_KEY=
# 카카오 REST API 키 — 비밀값 아님(인가 URL에 그대로 노출됨). 서버의 KAKAO_CLIENT_ID와 동일한 값을 넣으면 됨.
EXPO_PUBLIC_KAKAO_CLIENT_ID=

# --- 서버 (Vercel 프로젝트 환경변수로 설정 — 커밋 금지) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
DATABASE_URL=
JWT_SECRET=
