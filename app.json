{
  "expo": {
    "name": "다잇다",
    "slug": "da-itda",
    "scheme": "daitda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.tjdwo5759.daitda",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "안심인증을 위해 신분증·외국인등록증 사진을 선택할 수 있도록 사진 라이브러리 접근 권한이 필요해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 이웃과의 실시간 급매칭 추천을 위해 위치 정보가 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "약속 상대방의 QR코드를 스캔해 현장 인증을 하려면 카메라 권한이 필요해요."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      "./plugins/withApkFileName.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ebe7ca1-6d3d-4aaf-900f-a674ee94f310"
      }
    },
    "owner": "qkqhtjdwo"
  }
}
